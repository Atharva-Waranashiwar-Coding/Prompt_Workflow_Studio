POSTGRES_DB=prompt_workflow_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/prompt_workflow_studio
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
DEFAULT_USER_EMAIL=dev@promptworkflow.local
DEFAULT_USER_NAME=Dev User
ENABLE_MCP_TOOLS=true
MCP_MOUNT_PATH=/mcp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_DEFAULT_QUEUE=workflow_runs
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=300
WORKFLOW_DEFAULT_TOKEN_BUDGET=8000
WORKFLOW_DEFAULT_CONTEXT_BUDGET=32000
